rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /products/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && isAdmin();
    }
    
    match /products/{productId}/variants/{variantId} {
      allow write: if request.auth != null;
    }
    
    match /categories/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && isAdmin();
    }
    
    match /design_assets/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && isAdmin();
    }
    
    match /users/{userId} {
      allow read: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null;
    }
    
    match /addresses/{addressId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.user_id;
      allow read, update, delete: if request.auth != null && (request.auth.uid == resource.data.user_id || isAdmin());
    }
    
    match /designs/{designId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.user_id;
      allow read, update, delete: if request.auth != null && (request.auth.uid == resource.data.user_id || isAdmin());
    }
    
    match /wishlists/{wishlistId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.user_id;
      allow read, delete: if request.auth != null && request.auth.uid == resource.data.user_id;
    }
    
    match /cart_items/{cartItemId} {
      allow read, write: if request.auth != null;
    }

    match /delivery_zones/{zoneId} {
      allow read: if true;
      allow write: if false;
    }

    match /orders/{orderId} {
      allow read, write: if request.auth != null;

      match /items/{itemId} {
        allow read, write: if request.auth != null;
      }
    }

    match /counters/orders {
      allow read, write: if request.auth != null;
    }

    match /admins/{adminId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /settings/{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
