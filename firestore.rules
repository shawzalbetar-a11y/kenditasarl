rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == "huhu@huhu.com" ||
        request.auth.uid == "fR4rjb0EzDT2U2Ti3wPKEdwP4x42"
      );
    }

    match /products/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && isAdmin();
    }
    
    match /products/{productId}/variants/{variantId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /categories/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && isAdmin();
    }
    
    match /design_assets/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && isAdmin();
    }

    match /asset_categories/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && isAdmin();
    }
    
    match /users/{userId} {
      allow read: if request.auth != null;
      allow update, delete: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow create: if request.auth != null;
    }
    
    match /addresses/{addressId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.user_id;
      allow read, update, delete: if request.auth != null && (request.auth.uid == resource.data.user_id || isAdmin());
    }
    
    match /designs/{designId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (isAdmin() || request.auth.uid == resource.data.user_id);
    }
    
    match /wishlists/{wishlistId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.user_id;
      allow read, delete: if request.auth != null && (request.auth.uid == resource.data.user_id || isAdmin());
    }
    
    match /cart_items/{cartItemId} {
      allow read, write: if request.auth != null;
    }

    match /user_uploads/{uploadId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.user_id;
      allow read, delete: if request.auth != null && (request.auth.uid == resource.data.user_id || isAdmin());
    }

    match /delivery_zones/{zoneId} {
      allow read: if true;
      allow write: if request.auth != null && isAdmin();
    }

    match /orders/{orderId} {
      allow read, write: if request.auth != null;

      match /items/{itemId} {
        allow read, write: if request.auth != null;
      }
    }

    match /counters/orders {
      allow read, write: if request.auth != null;
    }

    match /admins/{adminId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (isAdmin() || request.auth.uid == adminId || request.auth.token.email == "huhu@huhu.com");
    }

    match /settings/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && isAdmin();
    }
  }
}
